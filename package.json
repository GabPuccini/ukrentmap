{
  "name": "ukrentmap",
  "version": "1.0.0",
  "private": true,
  "description": "UK private rents by postcode district as a colour-coded map. Installable, works offline.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-vendor.mjs",
    "build": "next build && node scripts/postbuild.mjs",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/ukrentmap npm run build",
    "preview": "node scripts/serve-out.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke.mjs",
    "data": "python3 scripts/fetch_data.py && python3 scripts/build_data.py",
    "data:fetch": "python3 scripts/fetch_data.py",
    "data:build": "python3 scripts/build_data.py",
    "icons": "python3 scripts/make_icons.py"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0",
    "next": "16.4.5",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
